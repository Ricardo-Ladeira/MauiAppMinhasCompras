<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.Relatorio"
             Title="Relatório"
             BackgroundColor="Snow">

    <StackLayout
        Padding="2"
        Spacing="25">
        <Image
            Source="report_png_free_download.png"
            HeightRequest="90"
            Aspect="AspectFit"
            SemanticProperties.Description="Relatório de Compras"/>

        <Label
            Text="Informe o período de compras a consultar"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"/>

        <Border
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Stroke="Black"
            BackgroundColor="Transparent">
            <HorizontalStackLayout
                HorizontalOptions="Center">
                <VerticalStackLayout
                    Padding="15">
                    <Label Text="Data inicial:"/>
                    <DatePicker x:Name="date_start"
                                Format="dd-MM-yyyy"/>
                </VerticalStackLayout>
                <VerticalStackLayout
                    Padding="15">
                    <Label Text="Data final:"/>
                    <DatePicker x:Name="date_end"
                                Format="dd-MM-yyyy"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>
        <StackLayout>
            <Button
                x:Name="SubmitBtn"
                Text="Pesquisa"
                SemanticProperties.Hint="Pesquisa o intervalo de datas desejada"
                Clicked="OnSubmitClicked"
                HorizontalOptions="Center"/>
        </StackLayout>
        <Border>
            <ScrollView>
                <StackLayout
                    Padding="5">
                    <ListView x:Name="lst_produtos"
                              HeightRequest="600">
                        <ListView.Header>
                            <Grid ColumnDefinitions="*,80,80,40,*,*"
                                  BackgroundColor="{StaticResource Gray100}">
                                <Label Grid.Column="0"
                                        Text="ID"
                                        Padding="5"
                                        FontAttributes="Bold"/>
                                <Label Grid.Column="1"
                                        Text="Descrição"
                                        FontAttributes="Bold"/>
                                <Label Grid.Column="2"
                                        Text="Preço"
                                        FontAttributes="Bold"/>
                                <Label Grid.Column="3"
                                        Text="Qnt"
                                        FontAttributes="Bold"/>
                                <Label Grid.Column="4"
                                        Text="Total"
                                        FontAttributes="Bold"/>
                                <Label Grid.Column="5"
                                        Text="Data"
                                        FontAttributes="Bold"/>
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Grid ColumnDefinitions="*,80,80,40,*,*">
                                        <Label Grid.Column="0"
                                                Text="{Binding Id}"
                                                Padding="5"/>
                                        <Label Grid.Column="1"
                                                Text="{Binding Descricao}"/>
                                        <Label Grid.Column="2"
                                                Text="{Binding Preco, StringFormat='{}{0:c}'}"/>
                                        <Label Grid.Column="3"
                                                Text="{Binding Quantidade}"/>
                                        <Label Grid.Column="4"
                                                Text="{Binding Total, StringFormat='{}{0:c}'}"/>
                                        <Label Grid.Column="5"
                                                Text="{Binding DataCadastro, StringFormat='{}{0:dd/MM/yy}'}"/>
                                    </Grid>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackLayout>
            </ScrollView>
        </Border>
    </StackLayout>

</ContentPage>
